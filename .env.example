# PostgreSQL / pgvector
POSTGRES_DB=cogniva
POSTGRES_USER=cogniva
POSTGRES_PASSWORD=cogniva_dev
POSTGRES_PORT=5432

# Backend
Database__ConnectionString=Host=localhost;Port=5432;Database=cogniva;Username=cogniva;Password=cogniva_dev
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Jwt__Issuer=Cogniva.Api
Jwt__Audience=Cogniva.Web
Jwt__Secret=replace-with-a-development-secret-at-least-32-characters-long
Jwt__ExpirationMinutes=60
FileStorage__UploadPath=Storage/uploads
FileStorage__MaxFileSizeMb=20

# Frontend
VITE_API_BASE_URL=http://localhost:5080

# Future AI provider configuration (not implemented in Phase 1)
AI__Provider=OpenAICompatible
AI__BaseUrl=https://api.openai.com/v1/
AI__ApiKey=
AI__ChatModel=
AI__SummaryModel=
AI__EmbeddingModel=text-embedding-3-small
AI__EmbeddingDimensions=1536
Chunking__TargetTokens=750
Chunking__OverlapTokens=120
Chunking__MinimumTokens=80
RAG__TopK=5
RAG__MaxCosineDistance=0.65
RAG__HistoryMessageLimit=8
RAG__MaxContextCharacters=12000
Summary__DirectSummaryMaxCharacters=16000
Summary__PartialBatchMaxCharacters=12000
Summary__MaxPartialSummariesPerFinalPrompt=8
Summary__PartialMaxTokens=350
Summary__FinalMaxTokens=700
